{
  "name": "fei/logger-client",
  "type": "library",
  "description": "Client side logger",
  "autoload": {
    "psr-4": {
      "Fei\\Service\\Logger\\Client\\": "src/"
    }
  },
  "license": "GPL-3.0",
  "authors": [
    {
      "name": "Yoctu",
      "email": "contact@yoctu.com",
      "homepage": "http://yoctu.com/"
    }
  ],
  "require": {
    "php": "^8.5",
    "fei/api-client": "dev-feature/php-8.5 as 3.0.0",
    "fei/logger-common": "dev-feature/php-8.5 as 2.0.0",
    "psr/log": "^1.1.4 || ^2.0 || ^3.0",
    "fei/entities": "dev-feature/php-8.5 as 3.0.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "codeception/codeception": "^5.1",
    "codeception/module-asserts": "^3.0",
    "squizlabs/php_codesniffer": "^3.13"
  },
  "repositories": {
    "fei-logger-common": {
      "type": "vcs",
      "url": "https://github.com/flash-global/logger-common",
      "no-api": true
    },
    "fei-api-client": {
      "type": "vcs",
      "url": "https://github.com/flash-global/api-client",
      "no-api": true
    },
    "fei-entities": {
      "type": "vcs",
      "url": "https://github.com/flash-global/entities",
      "no-api": true
    }
  }
}
